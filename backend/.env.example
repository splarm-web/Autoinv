# Base de datos (SQLite local; cambiar a postgresql://... para producción)
DATABASE_URL=sqlite:///./data/app.db

# Seguridad JWT — cambia esto en producción
SECRET_KEY=cambia-esto-en-produccion-usa-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Almacenamiento de ficheros (ruta local; apuntar a S3/GCS en producción)
FILES_ROOT=./data/files

# API de Anthropic (para extracción OCR de tickets)
ANTHROPIC_API_KEY=sk-ant-...

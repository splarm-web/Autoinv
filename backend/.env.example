# Base de datos (SQLite local; cambiar a postgresql://... para producción)
DATABASE_URL=sqlite:///./data/app.db

# Seguridad JWT — cambia esto en producción
SECRET_KEY=cambia-esto-en-produccion-usa-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Almacenamiento de ficheros (ruta local; apuntar a S3/GCS en producción)
FILES_ROOT=./data/files

# API de Anthropic (para extracción OCR de tickets)
ANTHROPIC_API_KEY=sk-ant-...

# Registro de nuevos usuarios (true durante el setup inicial, false después)
REGISTRATION_ENABLED=true

# Orígenes permitidos para CORS (separados por coma; * para desarrollo local)
ALLOWED_ORIGINS=*

# Notificaciones push (Web Push / VAPID).
# Generar un par de claves con:
#   python -c "from py_vapid import Vapid01; ..."  (ver README de automatización)
# Sin estas claves el push queda desactivado, el resto de la app funciona igual.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Envío de facturas por email.
# El plan gratuito de Render bloquea los puertos SMTP, así que allí hace falta
# mandar por HTTPS: crea una cuenta en brevo.com, verifica el remitente y pega
# aquí la API key. Sin esta clave se intenta por SMTP directo (vale en local).
BREVO_API_KEY=
